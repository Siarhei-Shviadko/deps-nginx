set $auth_enabled           "${AUTH_ENABLED}";
set $authorization_upstream "${UPSTREAM_AUTHORIZATION_URL}";

if ($http_host = "") {
  return 444;
}

location / {
    try_files $uri $uri/ @fallback;
}

location ~ ^/(assets|scripts|styles)/ {
    proxy_buffering off;
    proxy_pass $frontend_upstream;
}

location @fallback {
    proxy_buffering off;
    proxy_pass $frontend_upstream;
}

location ~ ^/api/v1 {
    limit_req zone=req_zone burst=28 delay=20;
    proxy_pass $api_gateway_upstream;
    include conf.d/conf/security/auth/auth.conf;
    include conf.d/conf/security/cors.conf;
}

