    limit_conn sse_conn_zone 300;
    limit_conn_status 429;

    proxy_pass $event_relay_upstream;
    include conf.d/conf/security/auth/auth.conf;
    include conf.d/conf/security/cors.conf;
    proxy_set_header Connection '';
    proxy_http_version 1.1;
    chunked_transfer_encoding off;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
}

