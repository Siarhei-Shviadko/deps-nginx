if ($request_method = 'OPTIONS') {

    add_header 'Access-Control-Allow-Origin' "$http_origin" always;
    add_header 'Access-Control-Allow-Methods' 'OPTIONS, GET, POST, PUT, PATCH, DELETE';
    add_header 'Access-Control-Allow-Headers' 'API-Key, DNT, User-Agent, X-Requested-With, X-CSRF-Token, If-Modified-Since, If-Unmodified-Since, If-Match, If-None-Match, Cache-Control, Content-Type, Range, ETag, Authorization';
    add_header 'Access-Control-Max-Age' 86400;
    add_header 'Content-Type' 'text/plain; charset=utf-8';
    add_header 'Content-Length' 0;

    return 204;
}

# cors_allowed is defined in ../http.conf.template
if ($cors_allowed){
    add_header 'Access-Control-Allow-Origin' "$http_origin" always;
}

add_header 'Access-Control-Allow-Methods' 'OPTIONS, GET, POST, PUT, PATCH, DELETE' always;
add_header 'Access-Control-Allow-Headers' 'API-Key, DNT, User-Agent, X-Requested-With, X-CSRF-Token, If-Modified-Since, If-Unmodified-Since, If-Match, If-None-Match, Cache-Control, Content-Type, Range, ETag, Authorization' always;
add_header 'Access-Control-Expose-Headers' 'ETag, Content-Length, Content-Range' always;
